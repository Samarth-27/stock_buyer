# MarketEye Configuration

# Environment & Server
NODE_ENV=development
PORT=3001

# Market Data Mode: 'mock' | 'kite' | 'upstox'
MARKET_DATA_MODE=mock

# Database: Leave empty for zero-setup SQLite, or provide PostgreSQL connection string
DATABASE_URL=

# CORS Origin for Web Client
CORS_ORIGIN=http://localhost:5173

# Zerodha Kite Connect Credentials (Optional, used only when MARKET_DATA_MODE=kite)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Upstox API Credentials (Optional, used only when MARKET_DATA_MODE=upstox)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=
